rules_version = '2';
service cloud.firestore { match /databases/{database}/documents { match /cases/{caseId} { allow create: if request.auth != null && request.resource.data.uid == request.auth.uid; allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid; } match /users/{uid} { allow read,write: if request.auth != null && request.auth.uid == uid; } } }
